generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String               @id @default(uuid()) @db.Uuid
  name            String
  email           String               @unique
  company         String?
  location        String?
  role            UserRole?
  createdAt       DateTime             @default(now()) @map("created_at")
  contactRequests ContactRequest[]
  listings        MarketplaceListing[]
  projects        Project[]

  @@map("users")
}

model Project {
  id                            String         @id @default(uuid()) @db.Uuid
  userId                        String         @db.Uuid
  name                          String
  location                      String?
  areaM2                        Decimal?       @map("area_m2")
  constructionYear              Int?           @map("construction_year")
  structureType                 StructureType? @map("structure_type")
  status                        ProjectStatus  @default(draft)
  hasHazardousMaterials         Boolean        @default(false) @map("has_hazardous_materials")
  nearGroundwaterOrUnstableSoil Boolean        @default(false) @map("near_groundwater_or_unstable_soil")
  distanceToNeighbors           String?        @map("distance_to_neighbors")
  isDensePollutionSensitiveArea Boolean        @default(false) @map("is_dense_pollution_sensitive_area")
  estimatedDemolitionCostPerM2  Decimal?       @map("estimated_demolition_cost_per_m2")
  createdAt                     DateTime       @default(now()) @map("created_at")
  updatedAt                     DateTime       @updatedAt @map("updated_at")
  analyses                      Analysis[]
  materials                     Material[]
  user                          User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("projects")
}

model Preset {
  id            String     @id @default(uuid()) @db.Uuid
  nameAr        String     @map("name_ar")
  nameEn        String?    @map("name_en")
  category      String
  iconUrl       String?    @map("icon_url")
  defaultValues Json       @map("default_values")
  createdAt     DateTime   @default(now()) @map("created_at")
  materials     Material[]

  @@map("presets")
}

model Material {
  id                       String               @id @default(uuid()) @db.Uuid
  projectId                String               @db.Uuid
  presetId                 String?              @db.Uuid
  name                     String
  category                 String
  quantity                 Decimal
  unit                     String
  notes                    String?
  technicalFeasibility     Json?                @map("technical_feasibility")
  environmentalPerformance Json?                @map("environmental_performance")
  economicViability        Json?                @map("economic_viability")
  safetyContamination      Json?                @map("safety_contamination")
  timeLogistics            Json?                @map("time_logistics")
  marketPolicy             Json?                @map("market_policy")
  overrides                Json                 @default("{}")
  reusabilityScore         Decimal?             @map("reusability_score")
  estimatedValue           Decimal?             @map("estimated_value")
  recommendedPath          RecommendedPath?     @map("recommended_path")
  isGated                  Boolean              @default(false) @map("is_gated")
  gatingReason             String?              @map("gating_reason")
  aiSuggested              Boolean              @default(false) @map("ai_suggested")
  createdAt                DateTime             @default(now()) @map("created_at")
  updatedAt                DateTime             @updatedAt @map("updated_at")
  listings                 MarketplaceListing[]
  preset                   Preset?              @relation(fields: [presetId], references: [id])
  project                  Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([presetId])
  @@index([category])
  @@map("materials")
}

model Analysis {
  id                  String   @id @default(uuid()) @db.Uuid
  projectId           String   @db.Uuid
  demolitionStrategy  Json?    @map("demolition_strategy")
  financialReport     Json?    @map("financial_report")
  environmentalReport Json?    @map("environmental_report")
  createdAt           DateTime @default(now()) @map("created_at")
  project             Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("analyses")
}

model MarketplaceListing {
  id                String            @id @default(uuid()) @db.Uuid
  userId            String            @db.Uuid
  materialId        String            @db.Uuid
  quantityAvailable Decimal           @map("quantity_available")
  price             Decimal?
  location          String?
  status            MarketplaceStatus @default(available)
  images            String[]
  createdAt         DateTime          @default(now()) @map("created_at")
  contactRequests   ContactRequest[]
  material          Material          @relation(fields: [materialId], references: [id], onDelete: Cascade)
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([materialId])
  @@index([status])
  @@index([location])
  @@map("marketplace_listings")
}

model ContactRequest {
  id          String               @id @default(uuid()) @db.Uuid
  listingId   String               @db.Uuid
  requesterId String               @db.Uuid
  message     String?
  status      ContactRequestStatus @default(pending)
  createdAt   DateTime             @default(now()) @map("created_at")
  listing     MarketplaceListing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  requester   User                 @relation(fields: [requesterId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@index([requesterId])
  @@index([status])
  @@map("contact_requests")
}

enum UserRole {
  individual
  developer
  consultant
  contractor
}

enum StructureType {
  residential
  commercial
  industrial
}

enum ProjectStatus {
  draft
  analyzing
  completed
}

enum RecommendedPath {
  direct_reuse
  refurbishment
  recycling
  safe_disposal
}

enum MarketplaceStatus {
  available
  reserved
  sold
}

enum ContactRequestStatus {
  pending
  accepted
  rejected
}
