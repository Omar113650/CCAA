{
  "openapi": "3.0.3",
  "info": {
    "title": "CCAA - Construction & Circular Analysis API",
    "version": "1.0.0",
    "description": "API backend for circular economy analysis in construction and demolition projects."
  },
  "servers": [
    {
      "url": "http://localhost:5000",
      "description": "Local Development Server"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Enter the Supabase access token (JWT) to authorize requests."
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "company": { "type": "string", "nullable": true },
          "location": { "type": "string", "nullable": true },
          "role": { "type": "string", "enum": ["individual", "developer", "consultant", "contractor"], "nullable": true },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "Project": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "userId": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "location": { "type": "string", "nullable": true },
          "areaM2": { "type": "number", "nullable": true },
          "constructionYear": { "type": "integer", "nullable": true },
          "structureType": { "type": "string", "enum": ["residential", "commercial", "industrial"], "nullable": true },
          "status": { "type": "string", "enum": ["draft", "analyzing", "completed"] },
          "hasHazardousMaterials": { "type": "boolean" },
          "nearGroundwaterOrUnstableSoil": { "type": "boolean" },
          "distanceToNeighbors": { "type": "string", "nullable": true },
          "isDensePollutionSensitiveArea": { "type": "boolean" },
          "estimatedDemolitionCostPerM2": { "type": "number", "nullable": true },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "Material": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "projectId": { "type": "string", "format": "uuid" },
          "presetId": { "type": "string", "format": "uuid", "nullable": true },
          "name": { "type": "string" },
          "category": { "type": "string" },
          "quantity": { "type": "number" },
          "unit": { "type": "string" },
          "notes": { "type": "string", "nullable": true },
          "technicalFeasibility": { "type": "object", "properties": { "score": { "type": "number" }, "notes": { "type": "string" } } },
          "environmentalPerformance": { "type": "object", "properties": { "score": { "type": "number" }, "notes": { "type": "string" } } },
          "economicViability": { "type": "object", "properties": { "score": { "type": "number" }, "notes": { "type": "string" } } },
          "safetyContamination": { "type": "object", "properties": { "score": { "type": "number" }, "notes": { "type": "string" } } },
          "timeLogistics": { "type": "object", "properties": { "score": { "type": "number" }, "notes": { "type": "string" } } },
          "marketPolicy": { "type": "object", "properties": { "score": { "type": "number" }, "notes": { "type": "string" } } },
          "overrides": { "type": "object" },
          "reusabilityScore": { "type": "number", "nullable": true },
          "estimatedValue": { "type": "number", "nullable": true },
          "recommendedPath": { "type": "string", "enum": ["direct_reuse", "refurbishment", "recycling", "safe_disposal"], "nullable": true },
          "isGated": { "type": "boolean" },
          "gatingReason": { "type": "string", "nullable": true },
          "aiSuggested": { "type": "boolean" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "MarketplaceListing": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "userId": { "type": "string", "format": "uuid" },
          "materialId": { "type": "string", "format": "uuid" },
          "quantityAvailable": { "type": "number" },
          "price": { "type": "number", "nullable": true },
          "location": { "type": "string", "nullable": true },
          "status": { "type": "string", "enum": ["available", "reserved", "sold"] },
          "images": { "type": "array", "items": { "type": "string" } },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "ContactRequest": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "listingId": { "type": "string", "format": "uuid" },
          "requesterId": { "type": "string", "format": "uuid" },
          "message": { "type": "string", "nullable": true },
          "status": { "type": "string", "enum": ["pending", "accepted", "rejected"] },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      }
    }
  },
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/projects/{projectId}/materials/upload": {
      "post": {
        "summary": "Upload a BOQ Excel file",
        "description": "Upload an Excel file to extract materials, match them with presets, and run the initial Gates Logic.",
        "parameters": [
          { "name": "projectId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "The BOQ Excel file (.xlsx)"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Materials processed and added successfully" }
        }
      }
    },
    "/api/projects/{projectId}/materials/{id}/assess": {
      "post": {
        "summary": "Assess material using AI",
        "description": "Upload an image of the material to assess its condition and accessibility using Google Gemini Vision.",
        "parameters": [
          { "name": "projectId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "image": {
                    "type": "string",
                    "format": "binary",
                    "description": "Image of the construction element"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "AI Assessment successful, material updated" }
        }
      }
    },
    "/api/projects/{projectId}/materials/{id}/evaluate": {
      "post": {
        "summary": "تقييم عنصر يدوياً وتطبيق بوابات القرار (Gates Engine)",
        "description": "يستقبل إجابات المستخدم عن حالة العنصر وإمكانية الوصول وهل يحتوي على مواد خطرة، ثم يطبق بوابات القرار الثلاث ويرجع القرار الفوري.\n\n**Smart Normalization:** الـ Backend يفهم أي قيمة عربية أو إنجليزية:\n- condition: 'جيدة' / 'good' / 'متوسطة' / 'fair' / 'سيئة' / 'bad' / 'تالف' / 'damaged'\n- accessibility: 'سهلة' / 'easy' / 'متوسطة' / 'fair' / 'صعبة' / 'hard' / 'inaccessible'\n- isHazardous: true / false / 'نعم' / 'لا' / 'yes' / 'no' / 1 / 0",
        "parameters": [
          { "name": "projectId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["condition", "accessibility"],
                "properties": {
                  "condition": {
                    "type": "string",
                    "description": "حالة العنصر - يقبل أي قيمة عربية أو إنجليزية",
                    "example": "سيئة"
                  },
                  "accessibility": {
                    "type": "string",
                    "description": "إمكانية الوصول - يقبل أي قيمة عربية أو إنجليزية",
                    "example": "صعبة"
                  },
                  "isHazardous": {
                    "description": "هل يحتوي على مواد خطرة؟ يقبل: true/false, 'نعم'/'لا', 'yes'/'no', 1/0",
                    "example": "نعم"
                  }
                }
              },
              "examples": {
                "scenario_hazardous": {
                  "summary": "عنصر يحتوي على مواد خطرة",
                  "value": { "condition": "جيدة", "accessibility": "سهلة", "isHazardous": "نعم" }
                },
                "scenario_damaged": {
                  "summary": "عنصر تالف",
                  "value": { "condition": "سيئة", "accessibility": "سهلة", "isHazardous": "لا" }
                },
                "scenario_inaccessible": {
                  "summary": "عنصر يتعذر الوصول إليه",
                  "value": { "condition": "جيدة", "accessibility": "صعبة", "isHazardous": "لا" }
                },
                "scenario_passes": {
                  "summary": "عنصر سليم - يمر لمحرك القرارات",
                  "value": { "condition": "جيدة", "accessibility": "سهلة", "isHazardous": "لا" }
                },
                "scenario_english": {
                  "summary": "إرسال بالإنجليزية",
                  "value": { "condition": "damaged", "accessibility": "easy", "isHazardous": false }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "تم التقييم بنجاح وإرجاع القرار",
            "content": {
              "application/json": {
                "examples": {
                  "gated_hazardous": {
                    "summary": "عنصر خطر - تخلص آمن",
                    "value": {
                      "success": true,
                      "message": "تم تقييم العنصر بنجاح",
                      "data": {
                        "decision": {
                          "condition": "جيدة",
                          "accessibility": "سهل",
                          "isHazardous": true,
                          "isGated": true,
                          "gatingReason": "Hazardous material detected",
                          "recommendedPath": "safe_disposal",
                          "message": "تم توجيه العنصر: Hazardous material detected"
                        }
                      }
                    }
                  },
                  "gated_damaged": {
                    "summary": "عنصر تالف - إعادة تدوير",
                    "value": {
                      "success": true,
                      "message": "تم تقييم العنصر بنجاح",
                      "data": {
                        "decision": {
                          "condition": "تالفة",
                          "accessibility": "سهل",
                          "isHazardous": false,
                          "isGated": true,
                          "gatingReason": "Damaged condition",
                          "recommendedPath": "recycling",
                          "message": "تم توجيه العنصر: Damaged condition"
                        }
                      }
                    }
                  },
                  "passes_to_engine": {
                    "summary": "عنصر سليم - يكمل لمحرك القرارات",
                    "value": {
                      "success": true,
                      "message": "تم تقييم العنصر بنجاح",
                      "data": {
                        "decision": {
                          "condition": "جيدة",
                          "accessibility": "سهل",
                          "isHazardous": false,
                          "isGated": false,
                          "gatingReason": null,
                          "recommendedPath": "pending_decision_engine",
                          "message": "العنصر سليم ويمر لمحرك القرارات"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/presets": {
      "get": {
        "summary": "Fetch all material presets",
        "description": "Returns a list of predefined materials and their categories.",
        "security": [],
        "responses": {
          "200": {
            "description": "Presets fetched successfully"
          }
        }
      }
    },
    "/api/users/register": {
      "post": {
        "summary": "Register a new user",
        "description": "Registers a user in Supabase Auth and creates their profile in the local database.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password", "name"],
                "properties": {
                  "email": { "type": "string", "format": "email", "example": "developer@ccaa.eg" },
                  "password": { "type": "string", "minLength": 6, "example": "strongPassword123" },
                  "name": { "type": "string", "minLength": 2, "maxLength": 100, "example": "أحمد المصري" },
                  "role": { "type": "string", "enum": ["individual", "developer", "consultant", "contractor"], "example": "developer" },
                  "company": { "type": "string", "maxLength": 200, "example": "إيجيبت كونستركشن" },
                  "location": { "type": "string", "maxLength": 200, "example": "القاهرة، مصر" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User registered successfully"
          }
        }
      }
    },
    "/api/users/login": {
      "post": {
        "summary": "User Login",
        "description": "Logs in a user with email/password and returns a JWT session token.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": { "type": "string", "format": "email", "example": "developer@ccaa.eg" },
                  "password": { "type": "string", "example": "strongPassword123" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful"
          }
        }
      }
    },
    "/api/users/me": {
      "get": {
        "summary": "Get authenticated user profile",
        "responses": {
          "200": {
            "description": "Profile fetched successfully"
          }
        }
      },
      "patch": {
        "summary": "Update user profile",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string", "minLength": 2, "maxLength": 100, "example": "أحمد علي" },
                  "company": { "type": "string", "maxLength": 200, "example": "المقاولون العرب" },
                  "location": { "type": "string", "maxLength": 200, "example": "الجيزة، مصر" },
                  "role": { "type": "string", "enum": ["individual", "developer", "consultant", "contractor"], "example": "contractor" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Profile updated successfully"
          }
        }
      }
    },
    "/api/projects": {
      "get": {
        "summary": "List all projects for the authenticated user",
        "responses": {
          "200": {
            "description": "Projects fetched successfully"
          }
        }
      },
      "post": {
        "summary": "Create a new project",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": { "type": "string", "minLength": 2, "maxLength": 200, "example": "مشروع هدم فيلا التجمع" },
                  "location": { "type": "string", "maxLength": 300, "example": "القاهرة الجديدة، مصر" },
                  "areaM2": { "type": "number", "minimum": 0.01, "example": 450.5 },
                  "constructionYear": { "type": "integer", "minimum": 1800, "maximum": 2030, "example": 1995 },
                  "structureType": { "type": "string", "enum": ["residential", "commercial", "industrial"], "example": "residential" },
                  "hasHazardousMaterials": { "type": "boolean", "example": false },
                  "nearGroundwaterOrUnstableSoil": { "type": "boolean", "example": true },
                  "distanceToNeighbors": { "type": "string", "example": "close" },
                  "isDensePollutionSensitiveArea": { "type": "boolean", "example": true },
                  "estimatedDemolitionCostPerM2": { "type": "number", "minimum": 0.01, "example": 150 }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Project created successfully"
          }
        }
      }
    },
    "/api/projects/{id}": {
      "get": {
        "summary": "Get full details of a specific project",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": {
            "description": "Project details fetched successfully"
          }
        }
      },
      "patch": {
        "summary": "Update project details",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string", "minLength": 2, "maxLength": 200, "example": "مشروع فيلا التجمع المعدل" },
                  "location": { "type": "string", "maxLength": 300, "example": "القاهرة الجديدة، مصر" },
                  "areaM2": { "type": "number", "minimum": 0.01, "example": 480 },
                  "constructionYear": { "type": "integer", "minimum": 1800, "maximum": 2030, "example": 1995 },
                  "structureType": { "type": "string", "enum": ["residential", "commercial", "industrial"], "example": "residential" },
                  "hasHazardousMaterials": { "type": "boolean", "example": false },
                  "nearGroundwaterOrUnstableSoil": { "type": "boolean", "example": true },
                  "distanceToNeighbors": { "type": "string", "example": "close" },
                  "isDensePollutionSensitiveArea": { "type": "boolean", "example": true },
                  "estimatedDemolitionCostPerM2": { "type": "number", "minimum": 0.01, "example": 160 }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Project updated successfully"
          }
        }
      },
      "delete": {
        "summary": "Delete a project",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": {
            "description": "Project deleted successfully"
          }
        }
      }
    },
    "/api/projects/{projectId}/materials": {
      "get": {
        "summary": "List all materials in a project",
        "parameters": [
          { "name": "projectId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": {
            "description": "Materials fetched successfully"
          }
        }
      },
      "post": {
        "summary": "Add a material to a project",
        "parameters": [
          { "name": "projectId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "category", "quantity", "unit"],
                "properties": {
                  "presetId": { "type": "string", "format": "uuid", "example": "d3b07384-d113-4ec2-a5d5-8947b1b36a88" },
                  "name": { "type": "string", "minLength": 1, "maxLength": 200, "example": "حديد تسليح مستخلص" },
                  "category": { "type": "string", "minLength": 1, "maxLength": 100, "example": "steel" },
                  "quantity": { "type": "number", "minimum": 0.001, "example": 12.5 },
                  "unit": { "type": "string", "minLength": 1, "maxLength": 50, "example": "ton" },
                  "notes": { "type": "string", "example": "بحالة جيدة جداً وغير متآكل" },
                  "technicalFeasibility": {
                    "type": "object",
                    "properties": {
                      "score": { "type": "number", "minimum": 0, "maximum": 10, "example": 8 },
                      "notes": { "type": "string", "example": "سهل التفكيك والفرز" }
                    }
                  },
                  "environmentalPerformance": {
                    "type": "object",
                    "properties": {
                      "score": { "type": "number", "minimum": 0, "maximum": 10, "example": 9 },
                      "notes": { "type": "string", "example": "بصمة كربونية منخفضة عند التدوير" }
                    }
                  },
                  "economicViability": {
                    "type": "object",
                    "properties": {
                      "score": { "type": "number", "minimum": 0, "maximum": 10, "example": 8 },
                      "notes": { "type": "string", "example": "مطلوب بشدة في السوق حالياً" }
                    }
                  },
                  "safetyContamination": {
                    "type": "object",
                    "properties": {
                      "score": { "type": "number", "minimum": 0, "maximum": 10, "example": 7 },
                      "notes": { "type": "string", "example": "آمن وخالٍ من الملوثات" }
                    }
                  },
                  "timeLogistics": {
                    "type": "object",
                    "properties": {
                      "score": { "type": "number", "minimum": 0, "maximum": 10, "example": 6 },
                      "notes": { "type": "string", "example": "يستغرق يومين للفرز والجمع" }
                    }
                  },
                  "marketPolicy": {
                    "type": "object",
                    "properties": {
                      "score": { "type": "number", "minimum": 0, "maximum": 10, "example": 8 },
                      "notes": { "type": "string", "example": "متوافق مع مواصفات إعادة الاستخدام" }
                    }
                  },
                  "overrides": {
                    "type": "object",
                    "example": { "greenCertificate": true }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Material added successfully"
          }
        }
      }
    },
    "/api/projects/{projectId}/materials/{id}": {
      "get": {
        "summary": "Get specific material details",
        "parameters": [
          { "name": "projectId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": {
            "description": "Material fetched successfully"
          }
        }
      },
      "patch": {
        "summary": "Update specific material evaluation",
        "parameters": [
          { "name": "projectId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": { "type": "string", "minLength": 1, "maxLength": 200, "example": "حديد تسليح مستخلص" },
